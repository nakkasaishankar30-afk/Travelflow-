rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'nakkasaishankar30@gmail.com'; }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    // Destinations
    match /destinations/{destId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /places/{placeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
      
      match /hotels/{hotelId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // User Data
    match /users/{userId}/trips/{tripId} {
      allow list, get: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    // Itineraries
    match /users/{userId}/itineraries/{itineraryId} {
      allow list, get: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    // Favorites
    match /users/{userId}/favorites/{favoriteId} {
      allow list, get: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/bookings/{bookingId} {
      allow list, get: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/payments/{payId} {
      allow list, get: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/subscriptions/{subId} {
      allow list, get: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    // Partner referral clicks & eligible bookings
    match /users/{userId}/referralClicks/{clickId} {
      allow list, get: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    // Checklists
    match /users/{userId}/checklists/{destId} {
      allow list, get: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();
      
      match /items/{itemId} {
        allow list, get: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount', 'helpfulUsers']));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
